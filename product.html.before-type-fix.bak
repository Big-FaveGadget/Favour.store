<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product preview | Big-Fave</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="index.html" aria-label="Big-Fave home">
      <span class="brand-mark">BF</span>
      <span class="brand-name">BIG-FAVE<small>ALL IN ONE GADGET STORE</small></span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
     <a href="index.html" aria-current="page">Home</a>
      <a href="shop.html" aria-current="page">Shop</a>
      <a href="electric-fan.html" aria-current="page">Electric fans</a>
       <a href="earphones.html" aria-current="page">Audio Accessories</a>
       <a href="completecharger.html" aria-current="page">Complete charger</a>
       <a href="cable.html" aria-current="page">Charging Cables</a>
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to bright mode">
        ☀️ <span>Bright mode</span>
      </button>
      <a class="cart-link" href="cart.html">Cart <span id="cartCount">0</span></a>
    </div>
  </header>

  <main class="product-page">
    <a class="plain-link back-link" href="shop.html">← Back to shop</a>

    <section class="product-preview">
      <div class="preview-gallery">
        <div class="preview-main-image">
          <img id="productImage" src="sample-product.jpg" alt="Product preview">
        </div>
        <div class="preview-thumbnails" id="productThumbnails">
          <button class="thumbnail active" type="button" aria-label="View product image 1">
            <img src="sample-product.jpg" alt="">
          </button>
          <button class="thumbnail" type="button" aria-label="View product image 2">
            <img src="sample-product-2.jpg" alt="">
          </button>
          <button class="thumbnail" type="button" aria-label="View product image 3">
            <img src="sample-product-3.jpg" alt="">
          </button>
        </div>
      </div>

      <div class="preview-details">
        <p class="eyebrow" id="productCategory">PRODUCT CATEGORY</p>
        <h1 id="productName">Sample product name</h1>
        <p class="preview-price" id="productPrice">Add your price</p>
        <p class="preview-description" id="productDescription">
          Product details will appear here. You can add information about the
          product, its features, and what comes in the box.
        </p>

        <label class="option-label" for="productType" hidden>Choose connector type</label>
        <select id="productType" hidden></select>

        <label class="option-label" for="productColor">Choose a color</label>
        <select id="productColor">
          <option value="Black">Black</option>
          <option value="White">White</option>
          <option value="Silver">Silver</option>
        </select>

        <label class="option-label" for="productQuantity">Quantity</label>
        <div class="quantity-control">
          <button id="quantityMinus" type="button" aria-label="Decrease quantity">−</button>
          <input id="productQuantity" type="number" min="1" value="1" inputmode="numeric">
          <button id="quantityPlus" type="button" aria-label="Increase quantity">+</button>
        </div>

        <button class="button button-primary add-preview-to-cart" id="addToCart" type="button">
          Add to cart
        </button>
        <p class="cart-message" id="cartMessage" aria-live="polite"></p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand" href="index.html">
      <span class="brand-mark">BF</span>
      <span class="brand-name">BIG-FAVE<small>ALL IN ONE GADGET STORE</small></span>
    </a>
    <p>Gadgets for everyday life.</p>
    <small>© <span id="year"></span> Big-Fave</small>
  </footer>

  <script src="app.js"></script>
</body>
</html>
